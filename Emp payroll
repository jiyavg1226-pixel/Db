# Salary Calculation
Def calculate_salary():
 Try:
 Basic = float(basic_entry.get())
 Hra = basic * 0.20
 Da = basic * 0.10
 Pf = basic * 0.12
 Gross = basic + hra + da
 Net = gross – pf Hra_entry.delete(0, tk.END)
 Hra_entry.insert(0, str(round(hra, 2)))
 Da_entry.delete(0, tk.END)
 Da_entry.insert(0, str(round(da, 2)))
 Pf_entry.delete(0, tk.END)
 Pf_entry.insert(0, str(round(pf, 2)))
 Gross_entry.delete(0, tk.END)
 Gross_entry.insert(0, str(round(gross, 2)))
 Net_entry.delete(0, tk.END)
 Net_entry.insert(0, str(round(net, 2)))
 Return hra, da, pf, gross, net
 Except ValueError:
 Messagebox.showerror(“Error”, “Enter valid Basic Salary”)
 Return None
# Clear Fields
Def clear():
 For entry in entries:
 Entry.delete(0, tk.END) # Insert Employee
Def insert():
 Try:
 Salary = calculate_salary()
 If salary is None:
 Return
 Emp = {
 “emp_id”: emp_id_entry.get(),
 “name”: name_entry.get(),
 “department”: dept_entry.get(),
 “basic”: float(basic_entry.get()),
 “hra”: salary[0],
 “da”: salary[1],
 “pf”: salary[2],
 “gross”: salary[3],
 “net”: salary[4]
 }
 If not emp[“emp_id”] or not emp[“name”]:
 Messagebox.showerror(“Error”, “Enter Employee ID and Name”)
 Return
 If collection.find_one({“emp_id”: emp[“emp_id”]}): Messagebox.showerror(“Error”, “Employee ID already exists”)
 Return
 Collection.insert_one(emp)
 Messagebox.showinfo(“Success”, “Employee Inserted Successfully”)
 Display()
 Clear()
 Except ValueError:
 Messagebox.showerror(“Error”, “Enter valid salary”)
# Update Employee
Def update():
 Try:
 Salary = calculate_salary()
 If salary is None:
 Return
 Emp_id = emp_id_entry.get()
 If not emp_id:
 Messagebox.showerror(“Error”, “Enter Employee ID”)
 Return
 Result = collection.update_one( {“emp_id”: emp_id},
 {“$set”: {
 “name”: name_entry.get(),
 “department”: dept_entry.get(),
 “basic”: float(basic_entry.get()),
 “hra”: salary[0],
 “da”: salary[1],
 “pf”: salary[2],
 “gross”: salary[3],
 “net”: salary[4]
 }}
 )
 If result.matched_count:
 Messagebox.showinfo(“Success”, “Employee Updated”)
 Display()
 Clear()
 Else:
 Messagebox.showerror(“Error”, “Employee Not Found”)
 Except ValueError:
 Messagebox.showerror(“Error”, “Enter valid salary”)
